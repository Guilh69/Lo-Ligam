# Sources brutes des visuels (photos/SVG bruts, souvent volumineux — Canva, exports).
# Les versions optimisées utilisées par l'appli vivent dans app/static/ et app/src/lib/assets/.
# (Ancien dossier /Photo/ à la racine, rangé ici le 2026-10-12.)
design-stock/brut/

# Bibliothèque de référence (carte de 71 Mo, lexique sous droits) : reste sur le disque.
Modules_cors/Base_donnees_linguistica/

# Données SIG brutes téléchargées (IGN, OSM, Dataverse…) : refaisables par les
# scripts de SIG/cadena, trop lourdes pour le dépôt.
/SIG/brut/
# Carte de l'Atlas sonore (LIMSI/LISN, CC BY-NC-SA) : contrôle seulement, pas republiée
/SIG/Limsi/
# Enquêtes vocales de l'Atlas sonore : démonstrateur local, refait par
# node SIG/cadena/lisn-enquistas.mjs (ni dans Git ni en ligne)
/app/static/data/enquistas-lisn.json

# design-stock : vidéos et archives restent sur le disque, hors Git (règle du 2026-10-12,
# PILOTATGE chantier 9). Les autres fichiers de plus de 1 Mo sont refusés par .githooks/pre-commit.
design-stock/**/*.mp4
design-stock/**/*.mov
design-stock/**/*.webm
design-stock/**/*.wav
design-stock/**/*.zip

# Python : fichièrs compilats
__pycache__/
